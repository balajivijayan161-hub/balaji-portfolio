# Free access key from https://web3forms.com
# Copy this file to .env for local development.
# On Vercel or Netlify, set the same variables in the project environment.
VITE_WEB3FORMS_KEY=

# Optional visitor sign-in. Leave both blank to hide Sign in.
# Use the anon public key from Supabase Project Settings → API.
# Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Overrides site.googleSiteVerification in src/data/portfolio.js.
VITE_GOOGLE_SITE_VERIFICATION=
